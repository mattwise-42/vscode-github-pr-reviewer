{
  "name": "github-pr-reviewer",
  "displayName": "GitHub PR Reviewer",
  "description": "ADO-style unresolved PR review thread sidebar for GitHub",
  "version": "0.0.7",
  "publisher": "mattwise-42",
  "repository": {
    "url": "https://github.com/mattwise-42/vscode-github-pr-reviewer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "github-reviewer",
          "title": "GitHub PR Reviewer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "github-reviewer": [
        {
          "id": "githubReviewer.reviewView",
          "name": "Pull Requests",
          "icon": "$(git-pull-request)"
        },
        {
          "id": "githubReviewer.openCommentsView",
          "name": "Open Comments",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "githubReviewer.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.showInTreeView",
        "title": "Show in GitHub Reviewer",
        "icon": "$(list-tree)",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.nextThread",
        "title": "Next Unresolved Thread",
        "icon": "$(arrow-down)",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.prevThread",
        "title": "Previous Unresolved Thread",
        "icon": "$(arrow-up)",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.resolveThread",
        "title": "Resolve",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.replyToThread",
        "title": "Reply to Thread",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.showResolved",
        "title": "Show Resolved Threads",
        "icon": "$(eye-closed)",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.hideResolved",
        "title": "Hide Resolved Threads",
        "icon": "$(eye)",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.openOriginalComment",
        "title": "Open on GitHub",
        "icon": "$(link-external)",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.expandPullRequest",
        "title": "Expand All",
        "icon": "$(expand-all)",
        "category": "GitHub PR Reviewer"
      },
      {
        "command": "githubReviewer.collapsePullRequest",
        "title": "Collapse",
        "icon": "$(collapse-all)",
        "category": "GitHub PR Reviewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "githubReviewer.showInTreeView",
          "when": "!explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "githubReviewer.showInTreeView",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "githubReviewer.showResolved",
          "when": "view == githubReviewer.reviewView && !githubReviewer.showResolved",
          "group": "navigation@0"
        },
        {
          "command": "githubReviewer.hideResolved",
          "when": "view == githubReviewer.reviewView && githubReviewer.showResolved",
          "group": "navigation@0"
        },
        {
          "command": "githubReviewer.prevThread",
          "when": "view == githubReviewer.reviewView",
          "group": "navigation@1"
        },
        {
          "command": "githubReviewer.nextThread",
          "when": "view == githubReviewer.reviewView",
          "group": "navigation@2"
        },
        {
          "command": "githubReviewer.refresh",
          "when": "view == githubReviewer.reviewView || view == githubReviewer.openCommentsView",
          "group": "navigation@3"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "githubReviewer.resolveThread",
          "when": "commentController == github-reviewer && commentThread == unresolved",
          "group": "inline"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "githubReviewer.replyToThread",
          "when": "commentController == github-reviewer",
          "group": "inline"
        },
        {
          "command": "githubReviewer.openOriginalComment",
          "when": "commentController == github-reviewer",
          "group": "inline@2"
        }
      ],
      "view/item/context": [
        {
          "command": "githubReviewer.expandPullRequest",
          "when": "view == githubReviewer.reviewView && viewItem == pr",
          "group": "inline@0"
        },
        {
          "command": "githubReviewer.collapsePullRequest",
          "when": "view == githubReviewer.reviewView && viewItem == pr",
          "group": "inline@1"
        },
        {
          "command": "githubReviewer.openOriginalComment",
          "when": "view == githubReviewer.reviewView && (viewItem =~ /^thread-/ || viewItem == comment)",
          "group": "inline@4"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package --no-dependencies",
    "test": "npm run build && node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@playwright/test": "^1.55.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
